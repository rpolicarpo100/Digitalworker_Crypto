# GOD — Global Opportunity Detector
# Environment Configuration — NEVER commit real secrets

# =============================================================================
# APP
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=GOD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# =============================================================================
# SUPABASE (PostgreSQL + Auth)
# Free tier: https://supabase.com — 500MB per project
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# MARKET DATA PROVIDERS (Free-first)
# =============================================================================
# CoinGecko — public API, no key required for low volume
# https://www.coingecko.com/en/api
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Binance — public market data, no key required
# https://binance-docs.github.io/apidocs/
BINANCE_API_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# DEX Screener — public API, no key
# https://docs.dexscreener.com/
DEXSCREENER_API_URL=https://api.dexscreener.com

# Alternative.me Fear & Greed — public, no key
# https://api.alternative.me/fng/
FEAR_GREED_API_URL=https://api.alternative.me

# =============================================================================
# BLOCKCHAIN INFRASTRUCTURE (Require keys for production)
# =============================================================================
# Alchemy — Free tier 30M CU/month, 25 RPS
# https://www.alchemy.com/
ALCHEMY_API_KEY=
ALCHEMY_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_SOL_RPC=https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Dune — On-chain analytics, free tier limited
# https://dune.com/
DUNE_API_KEY=

# =============================================================================
# AI PROVIDER (Abstraction — free-first routing)
# =============================================================================
# OpenAI-compatible interface, allows swapping providers
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-random-32-chars
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_DEX=true
ENABLE_WHALES=false
ENABLE_ARBITRAGE=true
ENABLE_AI=false
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_DUNE=false
ENABLE_ALCHEMY=false

# =============================================================================
# RATE LIMITS & GOVERNOR
# =============================================================================
RATE_LIMIT_COINGECKO_RPM=10
RATE_LIMIT_BINANCE_RPM=1200
RATE_LIMIT_DEXSCREENER_RPM=60
CACHE_PRICES_TTL_MS=10000
CACHE_MARKET_TTL_MS=60000
CACHE_METADATA_TTL_MS=1800000

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
